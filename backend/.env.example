# Placeholders only — never commit real secrets.
#
# Local development:
#   cp .env.example .env.development
#   # then fill Azure OpenAI / Langfuse values as needed
#   uv run --env-file .env.development uvicorn app.main:app --reload
#
# Local testing against cloud services (Neon / Qdrant Cloud / Upstash):
#   cp .env.example .env.production
#   # replace local URLs with cloud values; set CHECKPOINT_BACKEND=postgres
#   uv run --env-file .env.production uvicorn app.main:app
#
# Azure Container Apps: inject the same keys as secrets/env vars.
# Do not bake .env.production into the container image.
#
# Settings read process environment only (no silent .env auto-load).

APP_NAME="Enterprise Agentic AI Platform"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Container platforms may set PORT; uvicorn reads it in the Docker CMD (not Settings).
PORT=8000

# Application database (SQLAlchemy asyncpg). Local Docker Postgres vs Neon Free.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_ai

# Redis. Local: redis://...  Upstash Free: rediss://...
# Used for short-lived RAG response caching and tenant agent rate limiting.
# Not used for application data or LangGraph checkpoints.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
RAG_CACHE_TTL_SECONDS=300
AGENT_RATE_LIMIT_REQUESTS=30
AGENT_RATE_LIMIT_WINDOW_SECONDS=60

# Qdrant. Local HTTP (no API key) vs Qdrant Cloud HTTPS + API key.
# Never put both localhost and cloud QDRANT_URL values in the same env file.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks_v2

# LangGraph checkpoints: memory (local) | postgres (same DATABASE_URL / Neon)
CHECKPOINT_BACKEND=memory

# Optional override for container deployments (defaults to monorepo ../mcp or /app/mcp)
MCP_SERVER_DIR=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

DOCUMENT_STORAGE_PATH=storage/documents
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DENSE_RETRIEVAL_WEIGHT=0.7
SPARSE_RETRIEVAL_WEIGHT=0.3
DENSE_IDENTIFIER_WEIGHT=0.5
SPARSE_IDENTIFIER_WEIGHT=0.5
RRF_K=60
HYBRID_RANK_WEIGHT=0.7
RERANKER_RANK_WEIGHT=0.3
FINAL_RRF_K=60
MULTI_QUERY_RRF_K=60
ORIGINAL_QUERY_WEIGHT=1.0
EXPANDED_QUERY_WEIGHT=0.7
QUERY_EXPANSION_MAX_COUNT=3
RETRIEVAL_CANDIDATE_MULTIPLIER=2
RETRIEVAL_CANDIDATE_MIN=10

# Browser origins allowed by CORS (JSON list). Production: Static Web Apps URL.
# Quote the whole JSON value for `uv run --env-file` so inner quotes are preserved.
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Langfuse (optional for local; not required for /health)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Production / cloud checklist (put these in .env.production or Container Apps)
# ---------------------------------------------------------------------------
# APP_ENV=production
# DEBUG=false
# CHECKPOINT_BACKEND=postgres
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
# REDIS_URL=rediss://default:TOKEN@HOST:6379
# REDIS_ENABLED=true
# RAG_CACHE_TTL_SECONDS=300
# AGENT_RATE_LIMIT_REQUESTS=30
# AGENT_RATE_LIMIT_WINDOW_SECONDS=60
# QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# CORS_ORIGINS='["https://YOUR-STATIC-WEB-APP.azurestaticapps.net"]'
# LANGFUSE_TRACING_ENVIRONMENT=production
# MCP_SERVER_DIR=/app/mcp
# DOCUMENT_STORAGE_PATH=/app/storage/documents
#
# Migrations against the selected DATABASE_URL:
#   uv run --env-file .env.development alembic upgrade head
#   uv run --env-file .env.production alembic upgrade head
#
# Postgres LangGraph checkpoint tables are created on startup when
# CHECKPOINT_BACKEND=postgres (AsyncPostgresSaver.setup()).

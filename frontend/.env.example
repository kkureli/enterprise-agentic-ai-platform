# Placeholders only — never commit real secrets or production credentials.
#
# Vite loads:
#   .env.development  → npm run dev
#   .env.production   → npm run build
#
# Setup:
#   cp .env.example .env.development
#   cp .env.example .env.production
#   # then set VITE_API_BASE_URL in .env.production to the public ACA API URL

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional local-only fallback when no demo tenant has been selected yet.
# Once GET /demo/tenants loads, the UI-selected tenant.id always wins.
# Do not set this in production playground builds — it previously overrode the selector.
# VITE_TENANT_ID=

# Production / Azure Static Web Apps build:
# VITE_API_BASE_URL=https://enterprise-agentic-ai-backend.jollyplant-fb706637.swedencentral.azurecontainerapps.io/api/v1
#
# Tenant selection uses GET /demo/tenants in the playground UI.
#
# Vite embeds VITE_* values into the static bundle at build time.

# Optional Firebase / GA4 website analytics (production builds only).
# Leave unset locally — Analytics is skipped when incomplete or when not PROD.
# Set these as GitHub Actions repository/environment variables for SWA builds.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

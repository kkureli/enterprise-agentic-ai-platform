# Placeholders only — never commit real secrets or production credentials.
#
# Vite loads:
#   .env.development  → npm run dev
#   .env.production   → npm run build
#
# Setup:
#   cp .env.example .env.development
#   cp .env.example .env.production
#   # then set VITE_API_BASE_URL in .env.production to the public ACA API URL

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_TENANT_ID=

# Production / Azure Static Web Apps build:
# VITE_API_BASE_URL=https://enterprise-agentic-ai-backend.jollyplant-fb706637.swedencentral.azurecontainerapps.io/api/v1
#
# Tenant selection uses GET /demo/tenants in the playground UI.
# VITE_TENANT_ID is optional fallback only.
#
# Vite embeds VITE_* values into the static bundle at build time.